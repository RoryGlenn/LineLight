+/**
+ * A live, copyable cancellation flag for an inference run.
+ *
+ * The public RunOptionsSetTerminate API permits another thread to request
+ * termination while a run is active. A plain bool cannot satisfy that contract
+ * without a data race. The optional generation source is used by the WebAssembly
+ * bridge: JavaScript writes a run generation into a process-lifetime atomic in
+ * shared Wasm memory, and executor workers observe it at their existing
+ * cancellation checkpoints.
+ */
+class RunTerminationFlag final {
+ public:
+  RunTerminationFlag() noexcept = default;
+
+  RunTerminationFlag(const RunTerminationFlag& other) noexcept
+      : locally_requested_{other.locally_requested_.load(std::memory_order_acquire)} {
+  }
+
+  RunTerminationFlag& operator=(const RunTerminationFlag& other) noexcept {
+    if (this != &other) {
+      locally_requested_.store(other.locally_requested_.load(std::memory_order_acquire),
+                               std::memory_order_release);
+      UnbindCancellationGeneration();
+    }
+    return *this;
+  }
+
+  RunTerminationFlag(RunTerminationFlag&& other) noexcept
+      : RunTerminationFlag{other} {
+  }
+
+  RunTerminationFlag& operator=(RunTerminationFlag&& other) noexcept {
+    return operator=(other);
+  }
+
+  RunTerminationFlag& operator=(bool requested) noexcept {
+    if (requested) {
+      Request();
+    } else {
+      Reset();
+    }
+    return *this;
+  }
+
+  operator bool() const noexcept {
+    if (locally_requested_.load(std::memory_order_acquire)) {
+      return true;
+    }
+
+    const auto* cancellation_generation = cancellation_generation_;
+    if (cancellation_generation == nullptr || observed_generation_ == nullptr || run_generation_ == 0 ||
+        cancellation_generation->load(std::memory_order_acquire) != run_generation_) {
+      return false;
+    }
+    return true;
+  }
+
+  void AcknowledgeExternalCancellation() const noexcept {
+    const auto* cancellation_generation = cancellation_generation_;
+    if (cancellation_generation != nullptr && observed_generation_ != nullptr && run_generation_ != 0 &&
+        cancellation_generation->load(std::memory_order_acquire) == run_generation_) {
+      // The executor calls this only after its cancellation Status wins the
+      // run's first-failure race. A late request or an independent winning
+      // failure therefore retains the original OrtRun error.
+      observed_generation_->store(run_generation_, std::memory_order_release);
+    }
+  }
+
+  void Request() noexcept {
+    locally_requested_.store(true, std::memory_order_release);
+  }
+
+  void Reset() noexcept {
+    locally_requested_.store(false, std::memory_order_release);
+  }
+
+  void BindCancellationGeneration(const std::atomic<uint32_t>* cancellation_generation,
+                                  std::atomic<uint32_t>* observed_generation,
+                                  uint32_t run_generation) noexcept {
+    cancellation_generation_ = cancellation_generation;
+    observed_generation_ = observed_generation;
+    run_generation_ = run_generation;
+  }
+
+  void UnbindCancellationGeneration() noexcept {
+    cancellation_generation_ = nullptr;
+    observed_generation_ = nullptr;
+    run_generation_ = 0;
+  }
+
+ private:
+  std::atomic<bool> locally_requested_{false};
+  // The Wasm owner binds these immediately before Run() and unbinds only after
+  // Run() returns. They are immutable while executor threads can observe them.
+  const std::atomic<uint32_t>* cancellation_generation_{nullptr};
+  std::atomic<uint32_t>* observed_generation_{nullptr};
+  uint32_t run_generation_{0};
+};
 }  // namespace onnxruntime
 
