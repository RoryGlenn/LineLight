+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+import type { OrtWasmModule } from './wasm-types';
+
+export interface WasmRunCancellationEvent {
+  readonly type: 'start' | 'end';
+  readonly generation: number;
+  readonly sharedBuffer?: SharedArrayBuffer;
+  readonly activeGenerationIndex?: number;
+  readonly cancellationGenerationIndex?: number;
+}
+
+export type WasmRunCancellationObserver = (event: WasmRunCancellationEvent) => void;
+
+type ActiveWasmRunCancellation = {
+  readonly generation: number;
+  readonly runOptionsHandle: number;
+  readonly wasm: OrtWasmModule;
+};
+
+let observer: WasmRunCancellationObserver | undefined;
+
+/**
+ * Installs an observer for the opt-in threaded-Wasm cancellation bridge.
+ *
+ * The start event deliberately exposes the Wasm SharedArrayBuffer. Consumers
+ * should forward only the two documented mailbox indices to a trusted agent and
+ * must write only the cancellation generation cell with Atomics.store(). The
+ * observer is not invoked for non-threaded Wasm memory or the proxy-worker path.
+ */
+export const setWasmRunCancellationObserver = (value?: WasmRunCancellationObserver): void => {
+  observer = value;
+};
+
+/**
+ * Requests cancellation through a start event received by another JavaScript
+ * agent. The active-generation check makes delayed or duplicated messages a
+ * no-op for later runs.
+ */
+export const requestWasmRunCancellation = (event: WasmRunCancellationEvent): boolean => {
+  if (
+    event.type !== 'start' ||
+    typeof SharedArrayBuffer === 'undefined' ||
+    !(event.sharedBuffer instanceof SharedArrayBuffer) ||
+    event.activeGenerationIndex === undefined ||
+    event.cancellationGenerationIndex === undefined
+  ) {
+    return false;
+  }
+
+  try {
+    const mailbox = new Uint32Array(event.sharedBuffer);
+    if (
+      !Number.isInteger(event.generation) ||
+      event.generation <= 0 ||
+      event.generation > 0xffffffff ||
+      !Number.isInteger(event.activeGenerationIndex) ||
+      !Number.isInteger(event.cancellationGenerationIndex) ||
+      event.activeGenerationIndex < 0 ||
+      event.cancellationGenerationIndex < 0 ||
+      event.cancellationGenerationIndex !== event.activeGenerationIndex + 1 ||
+      event.activeGenerationIndex >= mailbox.length ||
+      event.cancellationGenerationIndex >= mailbox.length ||
+      Atomics.load(mailbox, event.activeGenerationIndex) !== event.generation
+    ) {
+      return false;
+    }
+
+    Atomics.store(mailbox, event.cancellationGenerationIndex, event.generation);
+    return true;
+  } catch {
+    // Forged, detached, or otherwise non-atomic buffers are never a valid
+    // cancellation channel.
+    return false;
+  }
+};
+
+const notifyObserver = (event: WasmRunCancellationEvent): void => {
+  try {
+    observer?.(event);
+  } catch {
+    // Cancellation instrumentation must never turn an otherwise valid run into
+    // an inference failure.
+  }
+};
+
+export const beginWasmRunCancellation = (
+  wasm: OrtWasmModule,
+  runOptionsHandle: number,
+): ActiveWasmRunCancellation | undefined => {
+  // wasm-core-impl creates a distinct run-options handle for each call, and
+  // its serialized wrapper keeps that handle exclusive until this run ends.
+  if (!observer || typeof SharedArrayBuffer === 'undefined') {
+    return undefined;
+  }
+
+  const buffer = wasm.HEAPU32.buffer;
+  if (!(buffer instanceof SharedArrayBuffer)) {
+    return undefined;
+  }
+
+  const mailboxByteOffset = wasm._OrtGetRunCancellationMailbox();
+  if (
+    mailboxByteOffset <= 0 ||
+    mailboxByteOffset % Uint32Array.BYTES_PER_ELEMENT !== 0 ||
+    mailboxByteOffset / Uint32Array.BYTES_PER_ELEMENT + 1 >= wasm.HEAPU32.length
+  ) {
+    return undefined;
+  }
+
+  // WebAssembly i32 results are signed JavaScript numbers. Normalize the C
+  // uint32_t generation before comparing it with Uint32Array/Atomics values.
+  const rawGeneration = wasm._OrtBeginRunCancellation(runOptionsHandle);
+  const generation = rawGeneration < 0 ? rawGeneration + 0x100000000 : rawGeneration;
+  if (generation === 0) {
+    return undefined;
+  }
+
+  const activeGenerationIndex = mailboxByteOffset / Uint32Array.BYTES_PER_ELEMENT;
+  notifyObserver({
+    type: 'start',
+    generation,
+    sharedBuffer: buffer,
+    activeGenerationIndex,
+    cancellationGenerationIndex: activeGenerationIndex + 1,
+  });
+
+  return { generation, runOptionsHandle, wasm };
+};
+
+export const endWasmRunCancellation = (active?: ActiveWasmRunCancellation): boolean => {
+  if (!active) {
+    return false;
+  }
+
+  const { generation, runOptionsHandle, wasm } = active;
+  const cancellationObserved = wasm._OrtEndRunCancellation(runOptionsHandle, generation) !== 0;
+  notifyObserver({ type: 'end', generation });
+  return cancellationObserved;
+};
+
+export class WasmRunCancellationError extends Error {
+  readonly code = 'ERR_ORT_WASM_RUN_CANCELED' as const;
+
+  constructor() {
+    super('The active WebAssembly inference run was canceled.');
+    this.name = 'AbortError';
+  }
+}
