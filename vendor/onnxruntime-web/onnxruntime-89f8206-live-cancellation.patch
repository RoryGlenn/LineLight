+
+struct alignas(uint32_t) RunCancellationMailbox {
+  std::atomic<uint32_t> active_generation{0};
+  std::atomic<uint32_t> cancellation_generation{0};
+  std::atomic<uint32_t> observed_generation{0};
+};
+
+static_assert(sizeof(std::atomic<uint32_t>) == sizeof(uint32_t),
+              "Wasm cancellation mailbox cells must match JavaScript Uint32Array cells.");
+static_assert(std::atomic<uint32_t>::is_always_lock_free,
+              "Wasm cancellation mailbox cells must use native atomic instructions.");
+static_assert(offsetof(RunCancellationMailbox, cancellation_generation) == sizeof(uint32_t),
+              "Wasm cancellation mailbox cells must be contiguous.");
+static_assert(offsetof(RunCancellationMailbox, observed_generation) == 2 * sizeof(uint32_t),
+              "Wasm cancellation acknowledgement must follow the public mailbox cells.");
+
+RunCancellationMailbox g_run_cancellation_mailbox;
+std::atomic<uint32_t> g_next_run_generation{1};
+
+uint32_t NextRunGeneration() {
+  // Generation zero means "no active cancellable run", so skip it. Generation
+  // reuse after the full 32-bit space is outside the supported lifetime of one
+  // Wasm instance; callers must not retain start events indefinitely.
+  uint32_t generation = g_next_run_generation.fetch_add(1, std::memory_order_relaxed);
+  if (generation == 0) {
+    generation = g_next_run_generation.fetch_add(1, std::memory_order_relaxed);
+  }
+  return generation;
+}
 }  // namespace
 
