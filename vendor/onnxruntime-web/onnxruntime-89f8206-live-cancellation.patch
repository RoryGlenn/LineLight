+void BindRunCancellationGeneration(OrtRunOptions* options,
+                                   const std::atomic<uint32_t>* cancellation_generation,
+                                   std::atomic<uint32_t>* observed_generation,
+                                   uint32_t generation) noexcept;
+void UnbindRunCancellationGeneration(OrtRunOptions* options) noexcept;
+}  // namespace onnxruntime
