+void* OrtGetRunCancellationMailbox() {
+  return static_cast<void*>(&g_run_cancellation_mailbox.active_generation);
+}
+
+uint32_t OrtBeginRunCancellation(OrtRunOptions* run_options) {
+  if (run_options == nullptr) {
+    return 0;
+  }
+
+  const uint32_t generation = NextRunGeneration();
+  uint32_t expected_generation = 0;
+  if (!g_run_cancellation_mailbox.active_generation.compare_exchange_strong(
+          expected_generation, generation, std::memory_order_acq_rel, std::memory_order_acquire)) {
+    return 0;
+  }
+
+  // No observer can know this generation before OrtBeginRunCancellation()
+  // returns, so clearing an old request here cannot race with its controller.
+  // The generation counter skips zero; a full 32-bit reuse remains outside the
+  // supported lifetime of one Wasm instance.
+  g_run_cancellation_mailbox.cancellation_generation.store(0, std::memory_order_release);
+  g_run_cancellation_mailbox.observed_generation.store(0, std::memory_order_release);
+  onnxruntime::BindRunCancellationGeneration(
+      run_options, &g_run_cancellation_mailbox.cancellation_generation,
+      &g_run_cancellation_mailbox.observed_generation, generation);
+  return generation;
+}
+
+int OrtIsRunCancellationRequested(uint32_t generation) {
+  return generation != 0 &&
+         g_run_cancellation_mailbox.cancellation_generation.load(std::memory_order_acquire) == generation;
+}
+
+int OrtEndRunCancellation(OrtRunOptions* run_options, uint32_t generation) {
+  if (run_options == nullptr || generation == 0) {
+    return 0;
+  }
+
+  // Capture the executor acknowledgement before publishing the mailbox as
+  // free. A later run is allowed to clear the private acknowledgement cell as
+  // soon as the active-generation compare/exchange succeeds below.
+  const bool cancellation_observed =
+      g_run_cancellation_mailbox.observed_generation.load(std::memory_order_acquire) == generation;
+  uint32_t expected_generation = generation;
+  if (g_run_cancellation_mailbox.active_generation.compare_exchange_strong(
+          expected_generation, 0, std::memory_order_acq_rel, std::memory_order_acquire)) {
+    // _OrtRun has returned before this function is called, so executor workers
+    // no longer hold references to this flag and it is safe to unbind.
+    onnxruntime::UnbindRunCancellationGeneration(run_options);
+    return cancellation_observed;
+  }
+
+  return 0;
+}
