diff --git a/js/web/test/unittests/backends/wasm/test-run-cancellation.ts b/js/web/test/unittests/backends/wasm/test-run-cancellation.ts
new file mode 100644
index 0000000000..93e292d327
--- /dev/null
+++ b/js/web/test/unittests/backends/wasm/test-run-cancellation.ts
@@ -0,0 +1,204 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+import { expect } from 'chai';
+
+import {
+  beginWasmRunCancellation,
+  endWasmRunCancellation,
+  requestWasmRunCancellation,
+  setWasmRunCancellationObserver,
+  type WasmRunCancellationEvent,
+  WasmRunCancellationError,
+} from '../../../../lib/wasm/run-cancellation';
+import type { OrtWasmModule } from '../../../../lib/wasm/wasm-types';
+
+const createFakeWasm = (buffer: ArrayBufferLike, generation = 41, mailboxAvailable = true) => {
+  const events: Array<{ method: string; runOptionsHandle: number; generation: number }> = [];
+  const mailboxByteOffset = 8;
+  const mailbox = new Uint32Array(buffer, mailboxByteOffset, 3);
+  const wasm = {
+    HEAPU32: new Uint32Array(buffer),
+    _OrtGetRunCancellationMailbox: () => mailboxByteOffset,
+    _OrtBeginRunCancellation: (runOptionsHandle: number) => {
+      if (!mailboxAvailable) {
+        return 0;
+      }
+      Atomics.store(mailbox, 0, generation);
+      Atomics.store(mailbox, 1, 0);
+      Atomics.store(mailbox, 2, 0);
+      events.push({ method: 'begin', runOptionsHandle, generation });
+      return generation;
+    },
+    _OrtIsRunCancellationRequested: (generation: number) => (Atomics.load(mailbox, 1) === generation ? 1 : 0),
+    _OrtEndRunCancellation: (runOptionsHandle: number, generation: number) => {
+      const observed = Atomics.load(mailbox, 2) === generation ? 1 : 0;
+      Atomics.store(mailbox, 0, 0);
+      events.push({ method: 'end', runOptionsHandle, generation });
+      return observed;
+    },
+  } as unknown as OrtWasmModule;
+  const observeCancellation = () => {
+    const activeGeneration = Atomics.load(mailbox, 0);
+    if (activeGeneration !== 0 && Atomics.load(mailbox, 1) === activeGeneration) {
+      Atomics.store(mailbox, 2, activeGeneration);
+      return true;
+    }
+    return false;
+  };
+  return { events, mailbox, observeCancellation, wasm };
+};
+
+describe('#UnitTest# - wasm - live run cancellation', () => {
+  afterEach(() => setWasmRunCancellationObserver());
+
+  it('publishes a shared generation and observes cancellation before ending the run', () => {
+    const { events, mailbox, observeCancellation, wasm } = createFakeWasm(new SharedArrayBuffer(32));
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    const active = beginWasmRunCancellation(wasm, 17);
+    expect(active?.generation).to.equal(41);
+    expect(observerEvents[0]).to.include({
+      type: 'start',
+      generation: 41,
+      activeGenerationIndex: 2,
+      cancellationGenerationIndex: 3,
+    });
+    expect(observerEvents[0].sharedBuffer).to.equal(mailbox.buffer);
+
+    expect(requestWasmRunCancellation(observerEvents[0])).to.equal(true);
+    expect(Atomics.load(mailbox, 1)).to.equal(41);
+    expect(observeCancellation()).to.equal(true);
+    expect(endWasmRunCancellation(active)).to.equal(true);
+    expect(events).to.deep.equal([
+      { method: 'begin', runOptionsHandle: 17, generation: 41 },
+      { method: 'end', runOptionsHandle: 17, generation: 41 },
+    ]);
+    expect(observerEvents[1]).to.deep.equal({ type: 'end', generation: 41 });
+  });
+
+  it('rejects a stale generation without touching the current run', () => {
+    const { mailbox, wasm } = createFakeWasm(new SharedArrayBuffer(32));
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    const active = beginWasmRunCancellation(wasm, 17);
+    expect(endWasmRunCancellation(active)).to.equal(false);
+    Atomics.store(mailbox, 0, 42);
+
+    expect(requestWasmRunCancellation(observerEvents[0])).to.equal(false);
+    expect(Atomics.load(mailbox, 1)).to.equal(0);
+  });
+
+  it('keeps a late request from masking an unrelated failure or poisoning the next run', () => {
+    const { mailbox, observeCancellation, wasm } = createFakeWasm(new SharedArrayBuffer(32));
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    const failedRun = beginWasmRunCancellation(wasm, 17);
+    expect(requestWasmRunCancellation(observerEvents[0])).to.equal(true);
+    // Execution has already failed for another reason, so no checkpoint reads
+    // the request and the original failure must remain visible to its caller.
+    expect(endWasmRunCancellation(failedRun)).to.equal(false);
+    expect(Atomics.load(mailbox, 2)).to.equal(0);
+
+    const nextRun = beginWasmRunCancellation(wasm, 18);
+    expect(nextRun).not.to.equal(undefined);
+    expect(observeCancellation()).to.equal(false);
+    expect(endWasmRunCancellation(nextRun)).to.equal(false);
+  });
+
+  it('normalizes an unsigned generation returned through WebAssembly i32', () => {
+    const { mailbox, observeCancellation, wasm } = createFakeWasm(new SharedArrayBuffer(32), -1);
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    const active = beginWasmRunCancellation(wasm, 17);
+    expect(active?.generation).to.equal(0xffffffff);
+    expect(requestWasmRunCancellation(observerEvents[0])).to.equal(true);
+    expect(Atomics.load(mailbox, 1)).to.equal(0xffffffff);
+    expect(observeCancellation()).to.equal(true);
+    expect(endWasmRunCancellation(active)).to.equal(true);
+  });
+
+  it('keeps generation zero reserved as the unavailable sentinel', () => {
+    const { events, wasm } = createFakeWasm(new SharedArrayBuffer(32), 0);
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    expect(beginWasmRunCancellation(wasm, 17)).to.equal(undefined);
+    expect(observerEvents).to.deep.equal([]);
+    expect(events).to.deep.equal([{ method: 'begin', runOptionsHandle: 17, generation: 0 }]);
+  });
+
+  it('rejects a forged non-adjacent cancellation cell', () => {
+    const buffer = new SharedArrayBuffer(32);
+    const mailbox = new Uint32Array(buffer);
+    Atomics.store(mailbox, 2, 41);
+
+    expect(
+      requestWasmRunCancellation({
+        type: 'start',
+        generation: 41,
+        sharedBuffer: buffer,
+        activeGenerationIndex: 2,
+        cancellationGenerationIndex: 5,
+      }),
+    ).to.equal(false);
+    expect(Atomics.load(mailbox, 5)).to.equal(0);
+  });
+
+  it('rejects an ArrayBuffer forged into the public event shape', () => {
+    expect(
+      requestWasmRunCancellation({
+        type: 'start',
+        generation: 41,
+        sharedBuffer: new ArrayBuffer(32) as unknown as SharedArrayBuffer,
+        activeGenerationIndex: 2,
+        cancellationGenerationIndex: 3,
+      }),
+    ).to.equal(false);
+  });
+
+  it('does not expose a non-shared Wasm heap', () => {
+    const { events, wasm } = createFakeWasm(new ArrayBuffer(32));
+    setWasmRunCancellationObserver(() => {
+      throw new Error('observer should not run');
+    });
+
+    expect(beginWasmRunCancellation(wasm, 17)).to.equal(undefined);
+    expect(events).to.deep.equal([]);
+  });
+
+  it('does not reserve a mailbox when no observer is installed', () => {
+    const { events, wasm } = createFakeWasm(new SharedArrayBuffer(32));
+
+    expect(beginWasmRunCancellation(wasm, 17)).to.equal(undefined);
+    expect(events).to.deep.equal([]);
+  });
+
+  it('leaves a concurrent run unchanged when the single mailbox is reserved', () => {
+    const { events, wasm } = createFakeWasm(new SharedArrayBuffer(32), 41, false);
+    const observerEvents: WasmRunCancellationEvent[] = [];
+    setWasmRunCancellationObserver((event) => observerEvents.push(event));
+
+    expect(beginWasmRunCancellation(wasm, 17)).to.equal(undefined);
+    expect(events).to.deep.equal([]);
+    expect(observerEvents).to.deep.equal([]);
+  });
+
+  it('contains observer failures and exposes a stable abort identity', () => {
+    const { wasm } = createFakeWasm(new SharedArrayBuffer(32));
+    setWasmRunCancellationObserver(() => {
+      throw new Error('application observer failed');
+    });
