+static_assert(std::is_copy_assignable<OrtRunOptions>::value,
+              "OrtRunOptions must remain copy assignable.");
+static_assert(std::is_move_constructible<OrtRunOptions>::value,
+              "OrtRunOptions must remain move constructible.");
+static_assert(std::is_move_assignable<OrtRunOptions>::value,
+              "OrtRunOptions must remain move assignable.");
+
+TEST(RunTerminationFlagTest, ObservesConcurrentLocalRequestAndReset) {
+  OrtRunOptions options;
+  std::atomic<bool> requester_started{false};
+  OrtStatus* request_status = nullptr;
+
+  std::thread requester([&]() {
+    requester_started.store(true, std::memory_order_release);
+    request_status = OrtApis::RunOptionsSetTerminate(&options);
+  });
+
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{5};
+  bool observed_request = false;
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (requester_started.load(std::memory_order_acquire) && options.terminate) {
+      observed_request = true;
+      break;
+    }
+    std::this_thread::yield();
+  }
+  requester.join();
+
+  EXPECT_EQ(request_status, nullptr);
+  EXPECT_TRUE(observed_request);
+  EXPECT_TRUE(options.terminate);
+  EXPECT_EQ(OrtApis::RunOptionsUnsetTerminate(&options), nullptr);
+  EXPECT_FALSE(options.terminate);
+}
+
+TEST(RunTerminationFlagTest, MatchesOnlyTheBoundExternalGeneration) {
+  std::atomic<uint32_t> cancellation_generation{6};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag flag;
+  flag.BindCancellationGeneration(&cancellation_generation, &observed_generation, 7);
+
+  EXPECT_FALSE(flag);
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+  cancellation_generation.store(7, std::memory_order_release);
+  EXPECT_TRUE(flag);
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+  flag.AcknowledgeExternalCancellation();
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 7u);
+
+  flag.UnbindCancellationGeneration();
+  EXPECT_FALSE(flag);
+  flag.BindCancellationGeneration(&cancellation_generation, &observed_generation, 8);
+  EXPECT_FALSE(flag);
+}
+
+TEST(RunTerminationFlagTest, DoesNotAcknowledgeARequestThatExecutionNeverObserved) {
+  std::atomic<uint32_t> cancellation_generation{0};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag flag;
+  flag.BindCancellationGeneration(&cancellation_generation, &observed_generation, 19);
+
+  // Model a request that arrives after the last execution checkpoint but
+  // before OrtEndRunCancellation. Merely writing the request cannot mask an
+  // unrelated OrtRun error as a cancellation.
+  cancellation_generation.store(19, std::memory_order_release);
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+
+  flag.UnbindCancellationGeneration();
+  EXPECT_FALSE(flag);
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+}
+
+TEST(RunTerminationFlagTest, ObservedRequestStillNeedsTheCancellationStatusToWin) {
+  std::atomic<uint32_t> cancellation_generation{23};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag flag;
+  flag.BindCancellationGeneration(&cancellation_generation, &observed_generation, 23);
+
+  // An executor can observe cancellation after another stream has already won
+  // the run's first-failure race. Without the winning-status acknowledgement,
+  // JavaScript must retain that independent failure.
+  EXPECT_TRUE(flag);
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+
+  flag.UnbindCancellationGeneration();
+  EXPECT_EQ(observed_generation.load(std::memory_order_acquire), 0u);
+}
+
+TEST(RunTerminationFlagTest, CopiesLocalStateWithoutLeakingActiveGeneration) {
+  std::atomic<uint32_t> cancellation_generation{0};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag original;
+  original.Request();
+  original.BindCancellationGeneration(&cancellation_generation, &observed_generation, 11);
+
+  RunTerminationFlag copied{original};
+  EXPECT_TRUE(copied);
+  copied.Reset();
+  cancellation_generation.store(11, std::memory_order_release);
+
+  EXPECT_TRUE(original);
+  EXPECT_FALSE(copied);
+}
+
+TEST(RunTerminationFlagTest, AssignmentDropsPreviousExternalBinding) {
+  std::atomic<uint32_t> cancellation_generation{13};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag source;
+  RunTerminationFlag destination;
+  destination.BindCancellationGeneration(&cancellation_generation, &observed_generation, 13);
+  ASSERT_TRUE(destination);
+
+  destination = source;
+  EXPECT_FALSE(destination);
+}
+
+TEST(RunTerminationFlagTest, MovePreservesLocalStateWithoutMovingExternalBinding) {
+  std::atomic<uint32_t> cancellation_generation{17};
+  std::atomic<uint32_t> observed_generation{0};
+  RunTerminationFlag source;
+  source.Request();
+  source.BindCancellationGeneration(&cancellation_generation, &observed_generation, 17);
+
+  RunTerminationFlag moved{std::move(source)};
+  EXPECT_TRUE(moved);
+  moved.Reset();
+  EXPECT_FALSE(moved);
+}
+
