  target_include_directories(main PRIVATE ${SAFEINT_INCLUDE_DIRS})

utf8-range provides CMake targets:

  # this is heuristically generated, and may not be correct
  find_package(utf8_range CONFIG REQUIRED)
  target_link_libraries(main PRIVATE utf8_range::utf8_range utf8_range::utf8_validity)

utf8-range provides pkg-config modules:

  # Google's UTF8 Library
  utf8_range

The package gtest is compatible with built-in CMake targets:

    enable_testing()
    
    find_package(GTest CONFIG REQUIRED)
    target_link_libraries(main PRIVATE GTest::gtest GTest::gtest_main GTest::gmock GTest::gmock_main)
    
    add_test(AllTestsInMain main)

