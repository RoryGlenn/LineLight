# Cache content-hashed assets immutably. Keeping this file in public also lets
# the deployed static-asset layer serve ONNX with WebAssembly's required MIME
# type before the service worker controls a first visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/assets/*.wasm
  Content-Type: application/wasm

# The deployment manifest is intentionally unversioned so old pages can detect
# a page/manifest mismatch and conservatively retain their hashes.
/runtime-assets.json
  Cache-Control: no-store
